{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bioagent.local/schema-profiles/experiment-trace-hybrid-v1.3.json",
  "title": "BioAgent F1 Hierarchical Recovery Trace Schema Extension v1.3",
  "x-version": "1.3",
  "base_schema": "experiment_trace_schema_v1.json",
  "condition_enum": ["F1"],
  "plan_properties": {
    "recovery_kind": {"const": "deterministic_then_typed_llm_replan"},
    "original_plan_preserved": {"const": true},
    "original_plan_sample_id": {"type": ["string", "null"], "pattern": "^plan_[a-f0-9]{24}$"},
    "deterministic_repair_attempted": {"type": "boolean"},
    "deterministic_repair_applied": {"type": "boolean"},
    "deterministic_repair_strategy": {"enum": ["none", "deterministic_bridge_insertion", "duplicate_invalid_step_pruning"]},
    "deterministic_plan_sample_id": {"type": ["string", "null"], "pattern": "^plan_[a-f0-9]{24}$"},
    "replan_triggered": {"type": "boolean"},
    "replan_applied": {"type": "boolean"},
    "replan_plan_sample_id": {"type": ["string", "null"], "pattern": "^plan_[a-f0-9]{24}$"},
    "extra_llm_calls": {"type": "integer", "minimum": 0, "maximum": 1},
    "extra_llm_input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "extra_llm_output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "extra_llm_total_tokens": {"type": ["integer", "null"], "minimum": 0},
    "replan_latency_ms": {"type": "number", "minimum": 0},
    "replan_outcome": {"enum": ["not_triggered", "deterministic_repair", "captured", "unparseable_plan", "unknown_tool_plan", "infrastructure_failure", "type_invalid_replan", "goal_incomplete_replan", "blocked_initial_artifact", "invalid_original_plan"]},
    "final_plan_source": {"enum": ["original", "deterministic_repair", "llm_replan", "rejected"]}
  }
}
